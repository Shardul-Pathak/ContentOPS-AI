# Application
DATABASE_URL="file:./dev.db"

# Agent execution provider: "trueforge" (real harness) or "mock" (deterministic fixtures for dev/tests)
AGENT_PROVIDER="mock"

# TrueForge server (local mode: npx @truefoundry/trueforge@latest -> http://localhost:8790)
TRUEFORGE_BASE_URL="http://localhost:8790"
# TRUEFORGE_TOKEN=            # ID token only when OIDC login is enabled on the TrueForge server

# Model provider — OpenAI-compatible endpoint registered into TrueForge Settings by scripts/seed-agents.ts.
# Keys are stored inside the TrueForge connector store; never in agent specs, DB, logs, or git.
#
# Example: OpenRouter (free NVIDIA Nemotron tier)
#   MODEL_PROVIDER_NAME=openrouter
#   MODEL_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#   MODEL_PROVIDER_API_KEY=sk-or-...
#   MODEL_UPSTREAM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   RESPONSE_FORMAT_MODE=json_schema
#   (→ agents reference MODEL_FQN "openrouter/nemotron-3-super-120b-a12b-free" automatically)
#
# NOTE on free variants: some ":free" models do NOT support response_format /
# structured_outputs (e.g. nvidia/nemotron-3.5-lightning:free). For those set
# RESPONSE_FORMAT_MODE=json_object — or better, pick a variant that lists
# structured_outputs (nemotron-3-super-120b-a12b:free does).
MODEL_PROVIDER_NAME=""
MODEL_PROVIDER_BASE_URL=""
MODEL_PROVIDER_API_KEY=""
MODEL_UPSTREAM_MODEL=""
# Optional override; auto-derived as "<provider>/<sanitized-upstream-name>" when unset
MODEL_FQN=""
# json_schema | json_object — final-output constraint per agent; Zod validation applies regardless
RESPONSE_FORMAT_MODE="json_schema"
# Tool-calling agents must not receive response_format (providers skip tool
# calls when a schema constraint is active). Comma-separated roles.
RESPONSE_FORMAT_SKIP_ROLES="research"
# Per-turn output cap — avoids provider 400s on misreported limits.
# Reasoning models (nemotron, qwen-thinking...) spend output tokens thinking;
# if you see "max_tokens breached", raise this and re-run seed:agents.
MODEL_MAX_OUTPUT_TOKENS="32768"

# Example: Groq (free tier, fast) — pick a model that lists "Tool Use" support
#   MODEL_PROVIDER_NAME=groq
#   MODEL_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
#   MODEL_PROVIDER_API_KEY=gsk_...
#   MODEL_UPSTREAM_MODEL=llama-3.3-70b-versatile

# Sandbox / skills (optional enhancement; requires a Daytona account)
ENABLE_SANDBOX="false"
DAYTONA_API_KEY=""
WRITER_SKILLS=""

# Publishing destination (in-repo mock CMS MCP endpoint by default)
CMS_MCP_HEADER_TOKEN="local-dev-cms-token"

# CMS MCP (mock company blog endpoint — npm run mock:cms)
CMS_MCP_SERVER_NAME="content-cms"
CMS_MCP_URL="http://localhost:3780/mcp"
MOCK_CMS_PORT="3780"
