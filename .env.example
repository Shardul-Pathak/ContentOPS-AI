# Application
DATABASE_URL="file:./dev.db"

# Agent execution provider: "trueforge" (real harness) or "mock" (deterministic fixtures for dev/tests)
AGENT_PROVIDER="mock"

# TrueForge server (local mode: npx @truefoundry/trueforge@latest -> http://localhost:8790)
TRUEFORGE_BASE_URL="http://localhost:8790"
# TRUEFORGE_TOKEN=            # ID token only when OIDC login is enabled on the TrueForge server

# Model provider — OpenAI-compatible endpoint registered into TrueForge Settings by scripts/seed-agents.ts.
# Keys are stored inside the TrueForge connector store; never in agent specs, DB, logs, or git.
MODEL_PROVIDER_NAME="primary"
MODEL_PROVIDER_BASE_URL=""
MODEL_PROVIDER_API_KEY=""
MODEL_FQN=""
# json_schema | json_object — final-output constraint per agent; Zod validation applies regardless
RESPONSE_FORMAT_MODE="json_schema"

# Sandbox / skills (optional enhancement; requires a Daytona account)
ENABLE_SANDBOX="false"
DAYTONA_API_KEY=""
WRITER_SKILLS=""

# Publishing destination (in-repo mock CMS MCP endpoint by default)
CMS_MCP_HEADER_TOKEN="local-dev-cms-token"

# CMS MCP (mock company blog endpoint — npm run mock:cms)
CMS_MCP_SERVER_NAME="content-cms"
CMS_MCP_URL="http://localhost:3780/mcp"
MOCK_CMS_PORT="3780"
