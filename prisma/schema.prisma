generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?
  website     String?
  industry    String?
  // Structured context sections (AGENTS.md section 7). SQLite has no scalar
  // lists, so object/array sections are stored as JSON and validated with Zod
  // at the service boundary before persistence.
  products         Json?
  audience         Json?
  brand            Json?
  marketing        Json?
  competitors      Json?
  allowedClaims    Json?
  prohibitedClaims Json?
  contentTypes     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaigns Campaign[]

  @@map("companies")
}

// SQLite has no native enums; status values are validated by Zod in the
// service layer (see src/contracts/campaign.ts).
model Campaign {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  description    String?
  goal           String?
  targetAudience String?
  topics         Json
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("campaigns")
}
