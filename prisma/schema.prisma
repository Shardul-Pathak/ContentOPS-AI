generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?
  website     String?
  industry    String?
  // Structured context sections (AGENTS.md section 7). SQLite has no scalar
  // lists, so object/array sections are stored as JSON and validated with Zod
  // at the service boundary before persistence.
  products         Json?
  audience         Json?
  brand            Json?
  marketing        Json?
  competitors      Json?
  allowedClaims    Json?
  prohibitedClaims Json?
  contentTypes     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaigns Campaign[]

  @@map("companies")
}

// SQLite has no native enums; status values are validated by Zod in the
// service layer (see src/contracts/campaign.ts).
model Campaign {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  description    String?
  goal           String?
  targetAudience String?
  topics         Json
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contents Content[]

  @@index([companyId])
  @@map("campaigns")
}

// One content item per workflow run (campaign topic + generated article).
// Stage artifacts are persisted as JSON after Zod validation — raw model
// output never lands here unvalidated.
model Content {
  id             String   @id @default(cuid())
  campaignId     String
  topic          String
  status         String   @default("CREATED")
  currentAgent   String?
  revisionCount  Int      @default(0)
  failureReason  String?

  research       Json?
  strategy       Json?
  draft          Json?
  qualityReview  Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  agentRuns AgentRun[]
  sources   ResearchSource[]
  assetRows Asset[] // persisted asset records (replaces the old assets JSON blob)
  @@index([campaignId])
  @@map("contents")
}

// Execution history for every agent invocation (AGENTS.md section 22).
// TrueForge session/turn ids + last sequence number enable resume after
// interruption via subscribeToTurn({ afterSequenceNumber }).
model AgentRun {
  id                  String    @id @default(cuid())
  contentId           String
  agentRole           String
  attempt             Int       @default(1)
  status              String    @default("RUNNING")
  trueforgeSessionId  String?
  trueforgeTurnId     String?
  lastSequenceNumber  Int       @default(0)
  activity            Json?
  output              Json?
  error               String?
  metrics             Json?
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("agent_runs")
}

// Provenance for every source returned by the research agent
// (AGENTS.md section 10: preserve source metadata; never invent sources).
model ResearchSource {
  id              String @id @default(cuid())
  contentId       String
  url             String
  title           String
  publisher       String
  relevance       String
  claimsSupported Json

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("research_sources")
}

// Generated visual assets for an article (hero required by default).
model Asset {
  id          String @id @default(cuid())
  contentId   String
  type        String
  url         String
  altText     String
  description String

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("assets")
}
